# Airflow Environment Configuration Template
# Copy this to .env and fill in your actual values

# Airflow Settings
AIRFLOW_UID=50000
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags

# AWS Credentials (for S3 and Redshift access)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=eu-west-2

# S3 Configuration
S3_BUCKET=github-assignment-raw-xxxxxxxx
S3_RAW_PATH=raw/sales_orders/

# Redshift Configuration
REDSHIFT_HOST=your-workgroup-name.123456789012.eu-west-2.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DBNAME=dev
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=YourSecurePassword123!
REDSHIFT_SCHEMA_STAGING=staging
REDSHIFT_SCHEMA_CURATED=curated

# IAM Role for Redshift COPY Command
IAM_ROLE_ARN=arn:aws:iam::123456789012:role/github-assignment-redshift-role

# Airflow Web UI
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Database Backend (SQLite for local, PostgreSQL for production)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////opt/airflow/airflow.db

# Executor (LocalExecutor for local, CeleryExecutor for production)
AIRFLOW__CORE__EXECUTOR=LocalExecutor
